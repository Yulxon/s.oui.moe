#!/usr/bin/env python3
"""Supply the Vault password to Ansible via stdout, never CLI arguments."""
import os
import sys

password = os.environ.get("ANSIBLE_VAULT_PASSWORD", "")
if not password or "\n" in password or "\r" in password:
    sys.exit("Set ANSIBLE_VAULT_PASSWORD to a nonempty, single-line Vault password.")
sys.stdout.write(password + "\n")
