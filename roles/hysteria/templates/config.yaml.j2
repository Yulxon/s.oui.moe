listen: :{{ hysteria_listen_ports }}

acme:
  domains:
    - {{ searxng_domain }}
    - {{ webvpn_domain }}
  email: {{ acme_email }}
  type: http

auth:
  type: password
  password: "{{ hysteria_auth_password }}"

masquerade:
  type: proxy
  proxy:
    url: http://{{ http_router_host }}:{{ http_router_port }}
    rewriteHost: false
    xForwarded: true
  listenHTTP: :80
  listenHTTPS: :443
  forceHTTPS: true
