listen: :{{ hysteria_listen_ports }}

acme:
  domains:
    - {{ public_domain }}
  email: {{ acme_email }}
  type: {{ hysteria_acme_type }}
{% if hysteria_acme_type == 'dns' %}
  dns:
    name: cloudflare
    config:
      cloudflare_api_token: {{ hysteria_cloudflare_api_token | to_json }}
{% endif %}

auth:
  type: password
  password: {{ hysteria_auth_password | to_json }}

masquerade:
  type: proxy
  proxy:
    url: {{ hysteria_masquerade_url }}
    rewriteHost: true
    xForwarded: false
  listenHTTP: :80
  listenHTTPS: :443
  forceHTTPS: true
