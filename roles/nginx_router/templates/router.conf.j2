map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen {{ http_router_host }}:{{ http_router_port }} default_server;
    server_name _;
    return 421;
}

server {
    listen {{ http_router_host }}:{{ http_router_port }};
    server_name {{ searxng_domain }};
    location / {
        proxy_pass http://{{ searxng_bind_address }}:{{ searxng_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}

server {
    listen {{ http_router_host }}:{{ http_router_port }};
    server_name {{ webvpn_domain }};
    auth_basic "Private WebVPN";
    auth_basic_user_file /etc/nginx/webvpn.htpasswd;
    location / {
        proxy_pass http://{{ scramjet_listen_host }}:{{ scramjet_listen_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
